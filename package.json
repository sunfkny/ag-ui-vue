{
  "name": "@synoped/ag-ui-vue",
  "version": "0.1.2",
  "description": "AG-UI protocol integration for Vue 3 — composables, state management, and frontend tool calling",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.47",
    "@ag-ui/core": "^0.0.47",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0",
    "happy-dom": "^17.4.0"
  },
  "license": "MIT"
}
